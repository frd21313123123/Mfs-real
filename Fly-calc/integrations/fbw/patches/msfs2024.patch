s:1fr 1fr;gap:22px}.fc-bottom-grid .fc-card p{font-size:13px}.fc-airport-pair{display:flex;align-items:center;gap:32px;margin:16px 0 28px}.fc-airport-pair div{flex:1}.fc-airport-pair strong{font-size:32px}.fc-airport-pair p{font-size:13px;margin:6px 0}.fc-airport-pair small{color:var(--fc-muted)}.fc-airport-pair>span{color:var(--fc-accent);font-size:25px}.fc-metrics{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--fc-border);padding-top:22px;margin-bottom:20px;gap:12px}.fc-metrics div{display:flex;flex-direction:column}.fc-metrics span,.fc-metrics small{font-size:12px;color:var(--fc-muted)}.fc-metrics strong{font-size:24px}.fc-doc-layout{display:grid;grid-template-columns:280px minmax(0,1fr);gap:20px}.fc-doc-list{padding:22px}.fc-doc-list p,.fc-doc-list small{font-size:12px;color:var(--fc-muted)}.fc-doc-item{display:block;width:100%;text-align:left;border:1px solid var(--fc-border);background:#0e1828;color:var(--fc-text);padding:12px;border-radius:8px;margin-bottom:10px}.fc-doc-item strong,.fc-doc-item small{display:block;overflow-wrap:anywhere}.fc-doc-item.selected{border-color:var(--fc-accent)}.fc-upload{margin-top:22px}.fc-upload input{font-size:11px;padding:10px}.fc-doc-view{padding:18px;overflow:auto;max-height:1100px}.fc-doc-view img{width:100%;height:auto;display:block;margin-top:18px}.fc-page-tools{display:flex;align-items:center;gap:16px;font-size:12px}.fc-page-tools button{border:1px solid var(--fc-border);background:#1c2a3f;color:var(--fc-text);border-radius:5px;padding:4px 12px}.fc-page-tools a{margin-left:auto;color:var(--fc-accent)}.fc-doc-empty{min-height:420px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--fc-muted);font-size:48px}.fc-doc-empty h2{color:var(--fc-text);margin:16px 0 0}.fc-doc-empty p{font-size:13px}.fc-source-row{display:flex;gap:18px;justify-content:space-between;padding:16px 0;border-bottom:1px solid var(--fc-border);font-size:13px}.fc-source-row span{color:var(--fc-muted);text-align:right}.fc-source-row+h2{margin-top:32px}.fc-footer{display:flex;justify-content:space-between;font-size:10px;letter-spacing:1px;color:#62748c;margin-top:12px;padding-bottom:20px}.fc-fenix .fc-route-inputs input{padding:28px}.fc-fenix button{min-height:48px}.fc-fenix .fc-main{max-width:none}
+@media(max-width:1050px){.fc-main{padding:28px}.fc-sidebar{width:200px;padding:28px 14px}.fc-submit-row{flex-wrap:wrap}.fc-header{gap:16px}.fc-root h1{font-size:27px}.fc-doc-layout{grid-template-columns:220px minmax(0,1fr)}}@media(max-width:760px){.fc-root{flex-direction:column}.fc-sidebar{width:100%;padding:14px;flex-direction:row;align-items:center;gap:8px;border-right:0;border-bottom:1px solid var(--fc-border)}.fc-logo{margin:0;font-size:18px}.fc-logo>span{width:30px;height:30px}.fc-sidebar>.fc-eyebrow,.fc-sidebar-bottom{display:none}.fc-sidebar>button{font-size:11px;margin:0;padding:9px}.fc-sidebar>button span{display:none}.fc-main{padding:20px}.fc-header{align-items:flex-start}.fc-badge{font-size:8px}.fc-card{padding:20px}.fc-route-inputs{gap:12px}.fc-route-inputs input{font-size:26px;padding:16px}.fc-bottom-grid,.fc-doc-layout{grid-template-columns:1fr}.fc-metrics{grid-template-columns:repeat(2,1fr)}.fc-source-row{flex-direction:column;gap:4px}.fc-source-row span{text-align:left}.fc-footer span{max-width:55%;text-align:right}}
+.fc-embedded{height:calc(100vh - 56px);min-height:0;overflow-y:auto}.fc-embedded .fc-main{padding:24px}.fc-embedded .fc-doc-view{max-height:calc(100vh - 245px)}.fc-embedded button{min-height:44px}
